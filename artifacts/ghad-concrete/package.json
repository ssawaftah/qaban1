{
  "name": "ghad-concrete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm build && wrangler pages dev dist/public --persist-to .wrangler/state",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ghad-concrete --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.23",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.6.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.149.0"
  }
}
